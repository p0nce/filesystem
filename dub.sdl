name "filesystem"
description "Implementation of roughly std::filesystem, for D."
copyright "Copyright 2026, Guillaume Piolat"
copyright "Copyright 2018, Steffen Schümann"
license "MIT"
targetPath "out/"

dependency "nulib" version="~>0.0"
dependency "nulib:io" version="~>0.0"
dependency "objective-d" version="~>1.1"

configuration "library" {
    targetType "library"
}

configuration "unittest" {
    targetType "autodetect"
    dependency "nusilly" version="~>1.0"
    sourcePaths "source/" "tests/"
    importPaths "source/" "tests/"
}
